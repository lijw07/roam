[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/characters/skeletons/skeleton_warrior.tscn" id="1_base"]
[ext_resource type="Script" path="res://scripts/enemy.gd" id="2_enemy"]
[ext_resource type="PackedScene" path="res://scenes/equipment/skeletons/skeleton_blade.tscn" id="3_skeleton_blade"]
[ext_resource type="PackedScene" path="res://scenes/equipment/skeletons/skeleton_shield_small_a.tscn" id="4_skeleton_shield_small_a"]
[ext_resource type="PackedScene" path="res://scenes/ui/enemy_health_bar.tscn" id="93_health_bar"]
[ext_resource type="Script" path="res://scripts/enemy_brain.gd" id="80_brain"]
