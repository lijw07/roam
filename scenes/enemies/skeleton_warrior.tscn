[node name="SkeletonWarrior" instance=ExtResource("1_base")]
script = ExtResource("2_enemy")
threat = 2
idle_animation = &"general/Idle_A"
attacks = Array[ExtResource("81_attack_step")]([ExtResource("82_slice_horizontal"), ExtResource("83_stab"), ExtResource("84_chop")])
attack_reach = 2.1
attack_damage = 14.0
block_stamina_per_damage = 0.6

[node name="HandslotRSkeletonBlade" type="BoneAttachment3D" parent="Model/Rig_Medium/Skeleton3D"]
bone_name = "handslot.r"

[node name="SkeletonBlade" parent="Model/Rig_Medium/Skeleton3D/HandslotRSkeletonBlade" instance=ExtResource("3_skeleton_blade")]

[node name="HandslotLSkeletonShieldSmallA" type="BoneAttachment3D" parent="Model/Rig_Medium/Skeleton3D"]
bone_name = "handslot.l"

[node name="SkeletonShieldSmallA" parent="Model/Rig_Medium/Skeleton3D/HandslotLSkeletonShieldSmallA" instance=ExtResource("4_skeleton_shield_small_a")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0.16)

[node name="Health" parent="."]
max_value = 200.0

[node name="HealthBar" parent="." node_paths=PackedStringArray("health", "hurtbox") instance=ExtResource("93_health_bar")]
health = NodePath("../Health")
hurtbox = NodePath("../Hurtbox")

[node name="Hurtbox" parent="."]
padding = 0.3

[node name="Brain" type="Node3D" parent="."]
script = ExtResource("80_brain")
attack_range = 1.8
circle_distance = 3.0
attack_cooldown = 1.8
block_skill = 1.5

[node name="ItemDropper" type="Node" parent="."]
script = ExtResource("95_item_dropper")
loot_tables = Array[ExtResource("96_loot_table")]([ExtResource("97_enemy_resources"), ExtResource("98_enemy_coins")])

[editable path="Model"]
