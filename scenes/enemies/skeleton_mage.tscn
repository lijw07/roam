[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/characters/skeletons/skeleton_mage.tscn" id="1_base"]
[ext_resource type="Script" path="res://scripts/enemy.gd" id="2_enemy"]
[ext_resource type="PackedScene" path="res://scenes/equipment/skeletons/skeleton_staff.tscn" id="3_skeleton_staff"]
[ext_resource type="PackedScene" path="res://scenes/ui/enemy_health_bar.tscn" id="93_health_bar"]
[ext_resource type="Script" path="res://scripts/enemy_brain.gd" id="80_brain"]
[ext_resource type="Script" path="res://scripts/attack_step.gd" id="81_attack_step"]
[ext_resource type="Resource" path="res://resources/attacks/magic/shoot.tres" id="82_shoot"]
[ext_resource type="Resource" path="res://resources/attacks/magic/long_spellcast.tres" id="83_long_spellcast"]
[ext_resource type="PackedScene" path="res://scenes/effects/skeleton_magic_bolt.tscn" id="89_projectile"]
[ext_resource type="Script" path="res://scripts/item_dropper.gd" id="95_item_dropper"]
[ext_resource type="Script" path="res://scripts/loot_table.gd" id="96_loot_table"]
[ext_resource type="Resource" path="res://resources/loot/enemy_resources.tres" id="97_enemy_resources"]
[ext_resource type="Resource" path="res://resources/loot/enemy_coins.tres" id="98_enemy_coins"]

[node name="SkeletonMage" instance=ExtResource("1_base")]
script = ExtResource("2_enemy")
threat = 3
idle_animation = &"tools/Holding_A"
attacks = Array[ExtResource("81_attack_step")]([ExtResource("82_shoot")])
projectile = ExtResource("89_projectile")
lead_in = ExtResource("83_long_spellcast")
attack_stamina_cost = 0.0

[node name="HandslotRSkeletonStaff" type="BoneAttachment3D" parent="Model/Rig_Medium/Skeleton3D"]
bone_name = "handslot.r"

[node name="SkeletonStaff" parent="Model/Rig_Medium/Skeleton3D/HandslotRSkeletonStaff" instance=ExtResource("3_skeleton_staff")]

[node name="Health" parent="."]
max_value = 120.0

[node name="HealthBar" parent="." node_paths=PackedStringArray("health", "hurtbox") instance=ExtResource("93_health_bar")]
health = NodePath("../Health")
hurtbox = NodePath("../Hurtbox")

[node name="Hurtbox" parent="."]
padding = 0.3

[node name="Brain" type="Node3D" parent="."]
script = ExtResource("80_brain")
sight_range = 11.0
attack_range = 11.0
circle_distance = 7.5
attack_cooldown = 2.5
block_skill = 0.4

[node name="ItemDropper" type="Node" parent="."]
script = ExtResource("95_item_dropper")
loot_tables = Array[ExtResource("96_loot_table")]([ExtResource("97_enemy_resources"), ExtResource("98_enemy_coins")])

[editable path="Model"]
