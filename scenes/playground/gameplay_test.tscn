[node name="CastEffects" type="Node3D" parent="." node_paths=PackedStringArray("player")]
script = ExtResource("15_cast_effects")
player = NodePath("../Player")

[node name="ProjectileWarmUp" type="Node3D" parent="." node_paths=PackedStringArray("player")]
