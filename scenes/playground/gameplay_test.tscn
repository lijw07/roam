amount_popup = NodePath("../AmountPopup")

[node name="AmountPopup" type="PanelContainer" parent="HUD"]
script = ExtResource("21_amount_popup")

[node name="LoadingCover" type="CanvasLayer" parent="."]
layer = 100

[node name="Cover" type="ColorRect" parent="LoadingCover"]
anchors_preset = 15
