[sub_resource type="Environment" id="Environment_dungeon"]
background_mode = 1
background_color = Color(0, 0, 0, 1)
ambient_light_source = 2
ambient_light_color = Color(0.12, 0.12, 0.16, 1)

[sub_resource type="NavigationMesh" id="NavigationMesh_dungeon"]
geometry_parsed_geometry_type = 1
agent_height = 2.0
agent_max_climb = 0.25

[node name="GameplayTest" type="Node3D"]
script = ExtResource("1_gameplay_test")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_dungeon")

[node name="NavigationRegion3D" type="NavigationRegion3D" parent="."]
navigation_mesh = SubResource("NavigationMesh_dungeon")

[node name="DungeonGenerator" type="Node3D" parent="NavigationRegion3D"]
script = ExtResource("2_dungeon_generator")

[node name="Player" parent="." instance=ExtResource("3_knight")]
script = ExtResource("4_dungeon_explorer")

[node name="Inventory" type="Node" parent="Player"]
script = ExtResource("5_inventory")

[node name="ItemCollector" type="Node" parent="Player" node_paths=PackedStringArray("inventory")]
script = ExtResource("6_item_collector")
inventory = NodePath("../Inventory")

[node name="ItemThrower" type="Node" parent="Player" node_paths=PackedStringArray("inventory")]
script = ExtResource("7_item_thrower")
inventory = NodePath("../Inventory")

[node name="StartingGear" type="Node3D" parent="."]
visible = false

[node name="Sword1Handed" parent="StartingGear" instance=ExtResource("8_sword_1handed")]

[node name="ShieldRound" parent="StartingGear" instance=ExtResource("9_shield_round")]

[node name="CombatDirector" type="Node" parent="." node_paths=PackedStringArray("target")]
script = ExtResource("10_combat_director")
