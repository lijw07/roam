[node name="AimTargeting" type="Node" parent="." node_paths=PackedStringArray("player")]
script = ExtResource("92_aim_targeting")
player = NodePath("../Player")

[node name="CameraRig" type="Node3D" parent="." node_paths=PackedStringArray("player", "shoulder_boom", "camera_boom", "camera")]
script = ExtResource("94_shoulder_camera")
player = NodePath("../Player")
shoulder_boom = NodePath("Pitch/ShoulderBoom")
camera_boom = NodePath("Pitch/ShoulderBoom/CameraBoom")
camera = NodePath("Pitch/ShoulderBoom/CameraBoom/Camera3D")

[node name="Pitch" type="Node3D" parent="CameraRig"]
transform = Transform3D(1, 0, 0, 0, 0.9393727, 0.3428978, 0, -0.3428978, 0.9393727, 0, 0, 0)

[node name="ShoulderBoom" type="SpringArm3D" parent="CameraRig/Pitch"]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 0, 0.25, 0)
script = ExtResource("17_camera_boom")
spring_length = 0.6
margin = 0.1

[node name="CameraBoom" type="SpringArm3D" parent="CameraRig/Pitch/ShoulderBoom"]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 0, 0, 0)
spring_length = 6.0
margin = 0.2
script = ExtResource("17_camera_boom")

[node name="Camera3D" type="Camera3D" parent="CameraRig/Pitch/ShoulderBoom/CameraBoom"]
fov = 60.0

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Crosshair" type="Control" parent="HUD"]
layout_mode = 3
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
mouse_filter = 2
script = ExtResource("93_crosshair")

[node name="Info" type="Label" parent="HUD"]
offset_left = 16.0
offset_top = 16.0
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6

[node name="VitalsHUD" parent="HUD" node_paths=PackedStringArray("health", "mana", "stamina") instance=ExtResource("18_vitals_hud")]
health = NodePath("../../Player/Health")
mana = NodePath("../../Player/Mana")
stamina = NodePath("../../Player/Stamina")

[node name="ItemIcons" type="Node" parent="HUD"]
script = ExtResource("19_item_icon_renderer")

[node name="Inventory" type="GridContainer" parent="HUD" node_paths=PackedStringArray("inventory", "icon_renderer", "amount_popup")]
