[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_main_menu"]

[ext_resource type="PackedScene" path="res://scenes/ui/menu_backdrop.tscn" id="ui_backdrop"]
[ext_resource type="Theme" path="res://resources/ui/minimal_theme.tres" id="ui_theme"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("ui_theme")
script = ExtResource("1_main_menu")

[node name="Background" parent="." instance=ExtResource("ui_backdrop")]
layout_mode = 1
view = 0

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 64
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 64

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 48
alignment = 1

[node name="TitleArea" type="CenterContainer" parent="Margin/Content"]
layout_mode = 2
mouse_filter = 2

[node name="Title" type="Label" parent="Margin/Content/TitleArea"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 52
text = "Roam"
horizontal_alignment = 1

[node name="ButtonArea" type="CenterContainer" parent="Margin/Content"]
layout_mode = 2
mouse_filter = 2

[node name="Buttons" type="VBoxContainer" parent="Margin/Content/ButtonArea"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="PlayButton" type="Button" parent="Margin/Content/ButtonArea/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
text = "Play"

[node name="SettingsButton" type="Button" parent="Margin/Content/ButtonArea/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
text = "Settings"

[node name="QuitButton" type="Button" parent="Margin/Content/ButtonArea/Buttons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
text = "Quit"
