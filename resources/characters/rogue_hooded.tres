[resource]
script = ExtResource("1_character_class")
description = "A dagger close at hand. A crossbow held in reserve."
lore = "The rogue once earned a living opening doors for people who owned too many keys. These days, abandoned vaults offer better company and fewer questions."
display_name = "Rogue"
character_scene = ExtResource("2_character")
weapons_text = "Daggers, fist weapons and one-handed crossbows"
starting_weapon = ExtResource("4_crossbow_1handed")
equipment = Array[PackedScene]([ExtResource("3_dagger"), ExtResource("4_crossbow_1handed"), ExtResource("5_dagger_a"), ExtResource("6_dagger_b"), ExtResource("7_fistweapon_a"), ExtResource("8_fistweapon_b")])
