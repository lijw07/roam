[sub_resource type="Resource" id="tier_very_rare"]
script = ExtResource("2_loot_tier")
weight = 3.0
items = Array[PackedScene]([ExtResource("scene_coin_stack_large")])

[resource]
script = ExtResource("1_loot_table")
tiers = Array[ExtResource("2_loot_tier")]([SubResource("tier_common"), SubResource("tier_uncommon"), SubResource("tier_rare"), SubResource("tier_very_rare")])
